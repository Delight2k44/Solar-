rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper to check if current user is an authorized Kinetix Admin
    function isAdmin() {
      return request.auth != null && 
        (
          request.auth.token.email.lower() == 'delightchetter@gmail.com' ||
          request.auth.token.email.lower() == 'admin@kinetixenergy.co.za'
        );
    }

    // Public Collections (Products, Site Content)
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /site_content/{sectionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Customer Submissions (Orders, Quotes, Commercial Leads, Contact Enquiries)
    match /orders/{orderId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
    }

    match /leads_quotes/{quoteId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /commercial_leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /contact_enquiries/{enquiryId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /maintenance_tickets/{ticketId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /installation_bookings/{bookingId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /email_notifications/{notifId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /user_notifications/{notifId} {
      allow create, read: if true;
      allow update, delete: if isAdmin();
    }

    // Catch-all fallback
    match /{document=**} {
      allow read, create: if true;
      allow update, delete: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
    }
  }
}
