rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (
          request.auth.token.email.lower() == 'form@kinetixes.com' ||
          request.auth.token.email.lower() == 'delightchetter@gmail.com' ||
          request.auth.token.email.lower() == 'admin@kinetixenergy.co.za'
        );
    }

    // Public catalog images, team photos, hero banners
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /site/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User documents (Invoices, CoCs, Site Photos)
    match /users/{userId}/{allPaths=**} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // Default rule
    match /{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
